# inventory-service settings. Shared values (DB host, JWT secret, ...) come
# from the root .env; anything set here takes precedence.

PORT=4004
DB_NAME=ims_inventory

# Services asked whether a product / warehouse exists before stock is first
# recorded for it.
PRODUCT_SERVICE_URL=http://localhost:4002
WAREHOUSE_SERVICE_URL=http://localhost:4003
UPSTREAM_TIMEOUT_MS=3000
UPSTREAM_RETRIES=2

# Create sample stock levels at startup (local development only).
SEED_DATA=true
