{
  "name": "inventory-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/inventory-service/src",
  "projectType": "application",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/inventory-service"],
      "options": {
        "command": "vite build --config apps/inventory-service/vite.config.mts"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "vite build --config apps/inventory-service/vite.config.mts --mode development --watch",
          "node --watch --enable-source-maps dist/apps/inventory-service/main.js"
        ],
        "parallel": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/inventory-service/tsconfig.json"
      }
    },
    "test-int": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest -c apps/inventory-service/jest.int.config.js --runInBand --passWithNoTests"
      }
    }
  }
}
