# api-gateway settings. Shared values (Redis URL, JWT secret, CORS origins)
# come from the root .env; anything set here takes precedence.

PORT=4000

# Downstream services
AUTH_SERVICE_URL=http://localhost:4001
PRODUCT_SERVICE_URL=http://localhost:4002
WAREHOUSE_SERVICE_URL=http://localhost:4003
INVENTORY_SERVICE_URL=http://localhost:4004

# Synchronous call resilience
UPSTREAM_TIMEOUT_MS=5000
UPSTREAM_RETRIES=2

# Rate limiting, per client IP
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
