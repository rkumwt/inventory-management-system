# auth-service settings. Shared values (DB host, JWT secrets, ...) come from
# the root .env; anything set here takes precedence.

PORT=4001
DB_NAME=ims_auth

# Create one sample user per role at startup (local development only):
#   admin@ims.local, manager@ims.local, staff@ims.local
# All three use the password below.
SEED_DATA=true
SEED_USER_PASSWORD=ChangeMe123!
