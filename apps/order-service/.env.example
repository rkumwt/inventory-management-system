# order-service settings. Shared values (DB host, JWT secret, RabbitMQ URL,
# ...) come from the root .env; anything set here takes precedence.

PORT=4005
DB_NAME=ims_order

# Services asked for product details and warehouse status when an order is
# placed.
PRODUCT_SERVICE_URL=http://localhost:4002
WAREHOUSE_SERVICE_URL=http://localhost:4003
UPSTREAM_TIMEOUT_MS=3000
UPSTREAM_RETRIES=2
