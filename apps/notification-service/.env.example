# notification-service settings. Shared values (DB host, JWT secret, RabbitMQ
# URL, ...) come from the root .env; anything set here takes precedence.

PORT=4006
DB_NAME=ims_notification

# Who receives low-stock alerts. Emails are mocked: they are written to the
# log and stored, never actually sent.
LOW_STOCK_ALERT_EMAIL=inventory-alerts@ims.local
