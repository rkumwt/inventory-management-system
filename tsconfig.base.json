{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "paths": {
      "@ims/common": ["libs/common/src/index.ts"],
      "@ims/config": ["libs/config/src/index.ts"],
      "@ims/database": ["libs/database/src/index.ts"],
      "@ims/events": ["libs/events/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "tmp"]
}
