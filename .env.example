# Shared local-development settings.
# Copy to .env (pnpm setup:env does this for you). Never commit .env.
#
# This file is read by Docker Compose and by every service. Each service adds
# its own settings (PORT, DB_NAME, ...) in apps/<service>/.env.

NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (one server locally, one database per service) ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=ims
DB_PASSWORD=ims_local_password
DB_SSL=false

# --- RabbitMQ (Amazon MQ in production) ---
RABBITMQ_USER=ims
RABBITMQ_PASSWORD=ims_local_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://ims:ims_local_password@localhost:5672

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- JWT (local-only values; generate real ones with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-0123456789
JWT_REFRESH_TTL_SECONDS=604800

# --- CORS (comma-separated origins allowed to call the gateway) ---
CORS_ORIGINS=http://localhost:3001
